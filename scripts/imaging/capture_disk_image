#!/usr/bin/env bash
# Capture a Pi's entire eMMC (partition table + all 7 partitions) as a single compressed
# .img.xz - the final step of make_progenitor. Whether the result is a normal dual-slot golden
# image or a single-slot progenitor image depends only on whether slot B is populated when this
# runs - same code path either way.
#
# Run only against an already-partitioned, already-deployed Pi that's had cleanup run right
# before shipping. Needs a USB-to-service-port connection (rpiboot mass-storage mode) - unlike
# make_images, this also captures the *active* slot, so the disk must be powered off first.

set -euo pipefail

helptext="Usage: capture_disk_image [OPTION]...
Capture a connected Pi's entire eMMC as a single compressed .img.xz, via rpiboot mass-storage mode.

  --output-dir, -o DIR: Output directory (default: current directory)
  --yes:                Skip the 'Type yes to continue' confirmation. For scripted use.
  --debug:              Print all commands, and don't unmount/cleanup on exit
  -h, --help:           Print this help text
"

out_dir='.'
assume_yes=false
debug=false

while [[ "$#" -gt 0 ]]; do
  case $1 in
    --output-dir|-o)
      if (($# > 1)); then out_dir=$2; shift; else echo "--output-dir requires a value"; exit 1; fi
      ;;
    --yes) assume_yes=true ;;
    --debug) debug=true ;;
    -h|--help) printf "%s" "$helptext"; exit 0 ;;
    *) printf "Unknown parameter passed: %s\n\n%s" "$1" "$helptext"; exit 1 ;;
  esac
  shift
done

$debug && set -x

out_dir="$(realpath -m "$out_dir")"
mkdir -p "$out_dir"

cleanup() {
  set +e
  [[ -n "${mnt:-}" ]] && sudo umount "$mnt" 2>/dev/null
  if ! $debug; then
    [[ -n "${mnt:-}" ]] && rmdir "$mnt" 2>/dev/null
  fi
}
trap cleanup EXIT

# ---- Step 1: get the Pi's eMMC exposed as a block device over USB ----
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=modules/rpiboot_connect.sh
source "$script_dir/modules/rpiboot_connect.sh"
# shellcheck source=modules/shrink_root.sh
source "$script_dir/modules/shrink_root.sh"
rpiboot_connect
# $diskpath is set by rpiboot_connect above.

# ---- Step 2: sanity-check the 7-partition layout, and report which slot(s) look populated
# (informational only). Checks both individually rather than assuming one - make_progenitor
# alternates which physical partition ends up populated each run, migrating onto whichever
# slot was inactive going in. ----
for i in 1 2 3 5 6 7; do
  [[ -e "${diskpath}-part${i}" ]] || { echo "Error: ${diskpath}-part${i} not found - this doesn't look like a 7-partition A/B disk"; exit 1; }
done

mnt=$(mktemp -d)
# A freshly-formatted, never-populated ext4 partition contains only lost+found. Anything else
# means this slot has real content on it.
#
# A mount failure here is a hard error, not "slot must be empty" - this is called via `&&`
# (`slot_populated ... && root_a_populated=true`), and `set -e` doesn't apply inside a command
# tested by `&&`, so a silent mount failure would otherwise read as "0 entries found".
slot_populated() {
  retry_on_partition sudo mount -o ro "$1" "$mnt" || { echo "Error: couldn't mount $1 after retries - can't tell if this slot is populated"; exit 1; }
  local entries
  entries=$(sudo ls -A "$mnt" | grep -vc '^lost+found$' || true)
  sudo umount "$mnt"
  [[ "$entries" -gt 0 ]]
}
root_a_populated=false
root_b_populated=false
slot_populated "${diskpath}-part5" && root_a_populated=true
slot_populated "${diskpath}-part6" && root_b_populated=true

if ! $root_a_populated && ! $root_b_populated; then
  echo "Error: neither root-A (p5) nor root-B (p6) has any content - this doesn't look like a real built slot"
  exit 1
elif $root_a_populated && $root_b_populated; then
  echo "Both root-A (p5) and root-B (p6) look populated - this will capture as a normal, already-dual-slot golden image."
else
  if $root_a_populated; then empty_slot="B (root-B/p6)"; else empty_slot="A (root-A/p5)"; fi
  echo "Slot $empty_slot looks empty - this will capture as a progenitor image (single-slot, fills in on first OTA update)."
fi

echo ""
echo "This will lock the pi password and remove SSH host keys/authorized_keys from every populated"
echo "slot on $diskpath, then image the result. Make sure this is a disposable/about-to-ship unit,"
echo "not one you're still relying on for SSH access."
if $assume_yes; then
  echo "--yes given, skipping confirmation."
else
  read -rp "Type 'yes' to continue: " confirm
  [[ "$confirm" == "yes" ]] || { echo "Aborted."; exit 1; }
fi

# ---- Step 2b: scrub per-unit credentials from every populated slot before capture - anything
# left here gets baked into every unit flashed from this image.
#   - pi account password: lock the /etc/shadow hash by prefixing it with '!' (same effect as
#     `passwd -l`) rather than clearing it - chpasswd overwrites this field wholesale when the
#     real first-boot password gets set, so this is only a lock until then, not a permanent one.
#   - authorized_keys: removed outright - nothing regenerates or revokes this on a real first
#     boot, so leaving it would mean permanent passwordless SSH access for whoever holds that key.
#   - support-tunnel device db + WireGuard configs: same idea as the older scripts/imaging/cleanup
#     tool already did for one-off customer units - if a support tunnel was ever activated on this
#     reference unit before capture, its real WireGuard private key and device registration would
#     otherwise get baked in and shared by every unit ever flashed from this image.
#   - persisted journal (/var/log/journal): same "baked into every unit flashed from this image"
#     problem as the credentials above. Removing the directory outright, not just its contents,
#     also restores the normal Storage=auto shipped default (volatile-only) instead of leaving
#     persistence on for every future unit from this image.
scrub_slot_identity() {
  local part="$1"
  local mnt2
  mnt2=$(mktemp -d)
  retry_on_partition sudo mount "$part" "$mnt2" || { echo "Error: couldn't mount $part after retries"; exit 1; }
  sudo sed -i '/^pi:!/!s/^pi:\([^:]*\):/pi:!\1:/' "$mnt2/etc/shadow"
  sudo rm -f "$mnt2/home/pi/.ssh/authorized_keys"
  sudo rm -f "$mnt2/var/lib/support_tunnel/device.db"
  sudo rm -f "$mnt2"/etc/wireguard/*
  sudo rm -rf "$mnt2/var/log/journal"
  sudo umount "$mnt2"
  rmdir "$mnt2"
}
if $root_a_populated; then
  echo "Locking pi account password and removing authorized_keys on root-A (p5)..."
  scrub_slot_identity "${diskpath}-part5"
fi
if $root_b_populated; then
  echo "Locking pi account password and removing authorized_keys on root-B (p6)..."
  scrub_slot_identity "${diskpath}-part6"
fi

# default_password.txt on p7 has to be cleared too, not just the password hash locked above -
# amplipi-firstboot.service's guard is "does this file already exist", and a leftover build/dev
# password would make that guard true forever, silently skipping password generation on every
# unit's real first boot. configure.py's _check_password has the identical guard for the same
# reason - this is the boot-time equivalent of resetting it.
echo "Clearing default_password.txt on /data (p7) so first boot regenerates a fresh one..."
retry_on_partition sudo mount "${diskpath}-part7" "$mnt" || { echo "Error: couldn't mount ${diskpath}-part7 after retries"; exit 1; }
sudo rm -f "$mnt/.config/amplipi/default_password.txt"

# house.json on p7 is deliberately left untouched here - make_progenitor's Stage 6 already puts
# it into the intended shipping state live, over the API, while the unit is still up and
# networked, before this disk is ever powered down for capture. Whatever's on house.json at
# capture time is meant to be captured as-is.

# SSH host keys on p7 need the same treatment - if this disk has ever booted (e.g. for
# verification before capture), sshd already generated real keys into /data/ssh/ once the masked
# regenerate_ssh_host_keys.service left the symlink targets missing. Delete them here so each real
# unit's own first boot regenerates a unique identity instead of every unit sharing this one.
if sudo find "$mnt/ssh" -mindepth 1 2>/dev/null | grep -q .; then
  echo "Clearing SSH host keys on /data (p7) so first boot generates a unique identity per unit..."
  sudo rm -f "$mnt"/ssh/ssh_host_*
fi

sudo umount "$mnt"

rmdir "$mnt"
unset mnt

# ---- Step 3: shrink each populated root slot's filesystem to its minimum footprint before
# imaging (modules/shrink_root.sh), so its unused tail streams as zero bytes below instead of real
# (slow-to-read-over-USB) leftover ext4 data - grown back immediately after capture (Step 4) so the
# source disk itself is left at its original size no matter what happens to it afterward. ----
p5_shrunk=''
p6_shrunk=''
if $root_a_populated; then
  echo "Shrinking root-A (p5) filesystem to its minimum size before imaging..."
  p5_shrunk=$(retry_on_partition shrink_root_fs "${diskpath}-part5")
fi
if $root_b_populated; then
  echo "Shrinking root-B (p6) filesystem to its minimum size before imaging..."
  p6_shrunk=$(retry_on_partition shrink_root_fs "${diskpath}-part6")
fi
echo "Cleaning filesystem on ${diskpath}-part7..."
retry_on_partition e2fsck_tolerant "${diskpath}-part7" || { echo "Error: e2fsck failed on ${diskpath}-part7 after retries"; exit 1; }

# ---- Step 4: stream the whole disk (partition table + every partition) straight through xz -
# p5/p6's shrunk tail streams as zero bytes, everything else streams verbatim. Grow whichever
# filesystem(s) were shrunk back to full size right after, regardless of whether the stream itself
# succeeded, so a mid-capture failure never leaves the source disk shrunk. ----
out_file="$out_dir/progenitor.img.xz"
echo "Imaging $diskpath → $(basename "$out_file") (this takes a while)..."
capture_ok=true
stream_disk_shrunk "$diskpath" "$p5_shrunk" "$p6_shrunk" | xz -T0 > "$out_file" || capture_ok=false
if [[ -n "$p5_shrunk" ]]; then
  echo "Growing root-A (p5) filesystem back to its full size..."
  retry_on_partition grow_root_fs "${diskpath}-part5"
fi
if [[ -n "$p6_shrunk" ]]; then
  echo "Growing root-B (p6) filesystem back to its full size..."
  retry_on_partition grow_root_fs "${diskpath}-part6"
fi
$capture_ok || { echo "Error: capture failed"; exit 1; }

sha256=$(sha256sum "$out_file" | cut -d' ' -f1)
size=$(stat -c%s "$out_file")

version=$(grep -m1 -oP '(?<=version = ")[^"]+' "$script_dir/../../pyproject.toml" || echo unknown)

manifest_file="$out_dir/progenitor-manifest.json"
# Remove any pre-existing manifest before writing, rather than truncating via `>` directly - a
# root-owned leftover (from an accidental sudo invocation) would reject overwriting its content
# even though this normal-user process can freely replace the file outright (a directory-permission thing).
rm -f "$manifest_file"
cat > "$manifest_file" <<EOF
{
  "version": "$version",
  "type": "disk-image",
  "filename": "$(basename "$out_file")",
  "sha256": "$sha256",
  "size": $size
}
EOF
# Not consumed by the OTA /update endpoint (that machinery only ever handles single-partition
# root/boot images, see make_image_manifest) - this manifest is just a record for whoever hosts
# and distributes the flashable image, e.g. to verify a download before writing it with Etcher/dd.

echo "
Wrote $out_file ($((size / 1024 / 1024)) MB) and $manifest_file.

This is a raw, flashable disk image (Balena Etcher or 'dd' straight onto a blank SD/eMMC) -
NOT an OTA update package. For that, see make_images/make_image_manifest instead.
"
