#!/usr/bin/env python3
# This is a separate script as it must be run with root privileges
# Example: sudo python check_pass 'raspberry'
#
# crypt/spwd were removed from the stdlib in Python 3.13 (PEP 594), so this uses their
# underlying primitives instead: /etc/shadow is just a colon-separated file, and crypt() is a
# regular libc function reachable via ctypes.

import ctypes
import ctypes.util
import sys

default_password = sys.argv[1]

with open('/etc/shadow', encoding='utf-8') as f:
  current_password = next(line.split(':')[1] for line in f if line.split(':')[0] == 'pi')

libcrypt = ctypes.CDLL(ctypes.util.find_library('crypt'))
libcrypt.crypt.restype = ctypes.c_char_p

if libcrypt.crypt(default_password.encode(), current_password.encode()) == current_password.encode():
  print("Correct Password")
  sys.exit(0)
print("Incorrect Password")
sys.exit(1)
