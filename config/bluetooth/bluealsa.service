[Unit]
Description=BluezALSA proxy
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=simple
User=root
# Sleep to avoid a race: After=bluetooth.service only guarantees org.bluez is on the bus, not that
# hci0's adapter paths are registered yet, and there's no unit to order against for that instead.
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/bluealsad -p a2dp-source -p a2dp-sink

[Install]
WantedBy=multi-user.target
